# AutoThreads - environment variables
# Salin file ini ke .env.local dan isi nilainya. .env.local TIDAK di-commit.
# Semua key berikut hanya dipakai di server (AGENTS.md aturan #8).

# Supabase (diisi setelah project Supabase dibuat - prasyarat P3)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI provider (diisi setelah verifikasi P1-P2, lihat docs/ai-provider.md)
GEMINI_API_KEY=
