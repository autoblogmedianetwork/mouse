# Salin ke .env.local untuk pengembangan, atau isi di Vercel.
# JANGAN commit .env.local ke Git.

# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Jangan dipakai di komponen klien.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Aplikasi ----------
APP_URL=http://localhost:3000
# Batas biaya AI per bulan dalam USD (K6). Pemanggilan AI berhenti saat tercapai.
AI_MONTHLY_BUDGET_USD=5
# Scraping Shopee (K5). Default nonaktif.
SCRAPING_ENABLED=false

# ---------- Provider AI per fungsi (ADR 0002) ----------
# chat: openrouter | groq | deepseek | mimo | off
AI_CHAT_PROVIDER=openrouter
# vision: openrouter | groq | (provider chat lain yang menerima gambar)
AI_VISION_PROVIDER=openrouter
# tts: elevenlabs | voicestudio | edge | off
AI_TTS_PROVIDER=off
# transcribe: groq | off
AI_TRANSCRIBE_PROVIDER=off

# ---------- Provider chat (ADR 0006) ----------
# generateJSON memanggil {AI_BASE_URL}/chat/completions dengan format OpenAI,
# jadi bebas diganti ke provider mana pun selama masih kompatibel.
# Contoh: https://api.deepseek.com/v1, https://api.groq.com/openai/v1,
# http://localhost:11434/v1 (Ollama), http://localhost:1234/v1 (LM Studio).
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Server-only. Jangan dipakai di komponen klien.
# OPENROUTER_API_KEY masih dibaca sebagai cadangan bila AI_API_KEY kosong.
AI_API_KEY=

# ---------- Kunci provider AI lain (untuk fitur yang belum aktif) ----------
OPENROUTER_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
MIMO_API_KEY=
MIMO_BASE_URL=
ELEVENLABS_API_KEY=

# ---------- Posting (ADR 0002) ----------
# manual | threads_api | buffer | metricool | postiz | mixpost
POSTING_PROVIDER=manual
THREADS_APP_ID=
THREADS_APP_SECRET=
BUFFER_ACCESS_TOKEN=
METRICOOL_API_KEY=
POSTIZ_API_URL=
POSTIZ_API_KEY=

# ---------- Tools media (ADR 0003, default off) ----------
# Kompresi foto: browser | off
MEDIA_COMPRESS=browser
# Hapus background: off | local | cloud
MEDIA_BG_REMOVAL=off
REMBG_URL=http://localhost:7001
# Render video template: off | local
MEDIA_VIDEO_RENDER=off
HYPERFRAMES_URL=http://localhost:7002
# TTS lokal: off | local (dipakai jika AI_TTS_PROVIDER=voicestudio)
VOICESTUDIO_URL=http://localhost:7003
# Token untuk memanggil tools lokal dari server yang berbeda (wajib jika tidak localhost)
MEDIA_TOOLS_TOKEN=
